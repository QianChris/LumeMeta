cmake_minimum_required(VERSION 3.19)
if (NOT TARGET MetaObject::API)
    find_package(AGPEngineAPI REQUIRED)
    get_filename_component(root_path "${CMAKE_CURRENT_LIST_DIR}/../" ABSOLUTE)
    add_library(MetaObject::API INTERFACE IMPORTED GLOBAL)
    set_property(TARGET MetaObject::API PROPERTY CXX_STANDARD 17)
    target_include_directories(MetaObject::API INTERFACE ${root_path}/include)
    target_link_libraries(MetaObject::API INTERFACE AGPBase::AGPBaseAPI AGPEngine::AGPEngineAPI)
endif()
set(MetaObjectAPI_FOUND true)