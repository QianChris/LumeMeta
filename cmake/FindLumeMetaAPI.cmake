cmake_minimum_required(VERSION 3.19)
if (NOT TARGET LumeMeta::API)
    find_package(AGPEngineAPI REQUIRED)
    get_filename_component(root_path "${CMAKE_CURRENT_LIST_DIR}/../" ABSOLUTE)
    add_library(LumeMeta::API INTERFACE IMPORTED GLOBAL)
    set_property(TARGET LumeMeta::API PROPERTY CXX_STANDARD 17)
    target_include_directories(LumeMeta::API INTERFACE ${root_path}/include)
    target_link_libraries(LumeMeta::API INTERFACE AGPBase::AGPBaseAPI AGPEngine::AGPEngineAPI)
endif()
set(LumeMetaAPI_FOUND true)