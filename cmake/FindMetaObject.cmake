cmake_minimum_required(VERSION 3.19)
if (NOT TARGET LumeMeta::Plugin)
    find_package(AGPEngineDLL REQUIRED)
    get_filename_component(root_path "${CMAKE_CURRENT_LIST_DIR}/../" ABSOLUTE)
    get_filename_component(bin_path "${root_path}/bin/" ABSOLUTE)
    add_library(LumeMeta::Plugin SHARED IMPORTED GLOBAL)
    if (${CMAKE_SYSTEM_NAME} STREQUAL "Android")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION "${bin_path}/Release/${CMAKE_ANDROID_ARCH_ABI}/libPluginMetaObject.so")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION_DEBUG "${bin_path}/Debug/${CMAKE_ANDROID_ARCH_ABI}/libPluginMetaObject.so")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION_RELEASE "${bin_path}/Release/${CMAKE_ANDROID_ARCH_ABI}/libPluginMetaObject.so")
    elseif (${CMAKE_SYSTEM_NAME} STREQUAL "Windows")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION "${bin_path}/Release/Win64/PluginMetaObject.dll")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION_DEBUG "${bin_path}/Debug/Win64/PluginMetaObject.dll")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION_RELEASE "${bin_path}/Release/Win64/PluginMetaObject.dll")
    else()
        message(FATAL_ERROR "Unknown system ${CMAKE_SYSTEM_NAME}")
    endif()
    add_dependencies(LumeMeta::Plugin AGPEngine::AGPEngineDLL)
endif()
set(MetaObject_FOUND true)