cmake_minimum_required(VERSION 3.19)
if (NOT TARGET LumeMeta::ExtAPI)
    find_package(LumeMetaAPI REQUIRED)
    get_filename_component(root_path "${CMAKE_CURRENT_LIST_DIR}/../" ABSOLUTE)
    add_library(LumeMeta::ExtAPI INTERFACE IMPORTED GLOBAL)
    set_property(TARGET LumeMeta::ExtAPI PROPERTY CXX_STANDARD 17)
    target_include_directories(LumeMeta::ExtAPI INTERFACE ${root_path}/include)
    target_link_libraries(LumeMeta::ExtAPI INTERFACE LumeMeta::API)
endif()
set(LumeMetaExtAPI_FOUND true)