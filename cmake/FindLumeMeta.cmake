cmake_minimum_required(VERSION 3.19)

if(NOT TARGET LumeMeta::Plugin)
    find_package(AGPEngineDLL REQUIRED)
    get_filename_component(root_path "${CMAKE_CURRENT_LIST_DIR}/../" ABSOLUTE)
    get_filename_component(bin_path "${root_path}/bin/" ABSOLUTE)
    add_library(LumeMeta::Plugin SHARED IMPORTED GLOBAL)

    if(CORE_PERF_ENABLED)
        set(release_mode "Profile")
    else()
        set(release_mode "Release")
    endif()

    if(${CMAKE_SYSTEM_NAME} STREQUAL "Android")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION "${bin_path}/${release_mode}/android/${CMAKE_ANDROID_ARCH_ABI}/libPluginLumeMeta.so")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION_DEBUG "${bin_path}/Debug/android/${CMAKE_ANDROID_ARCH_ABI}/libPluginLumeMeta.so")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION_RELEASE "${bin_path}/${release_mode}/android/${CMAKE_ANDROID_ARCH_ABI}/libPluginLumeMeta.so")
    elseif (OHOS)
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION "${bin_path}/Release/OHOS/${CMAKE_OHOS_ARCH_ABI}/libPluginLumeMeta.so")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION_DEBUG "${bin_path}/Debug/OHOS/${CMAKE_OHOS_ARCH_ABI}/libPluginLumeMeta.so")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION_RELEASE "${bin_path}/Release/OHOS/${CMAKE_OHOS_ARCH_ABI}/libPluginLumeMeta.so")
    elseif(${CMAKE_SYSTEM_NAME} STREQUAL "Windows")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION "${bin_path}/${release_mode}/windows/x64/PluginLumeMeta.dll")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION_DEBUG "${bin_path}/Debug/windows/x64/PluginLumeMeta.dll")
        set_property(TARGET LumeMeta::Plugin PROPERTY IMPORTED_LOCATION_RELEASE "${bin_path}/${release_mode}/windows/x64/PluginLumeMeta.dll")
    else()
        message(FATAL_ERROR "Unknown system ${CMAKE_SYSTEM_NAME}")
    endif()

    add_dependencies(LumeMeta::Plugin AGPEngine::AGPEngineDLL)
endif()

set(LumeMeta_FOUND true)