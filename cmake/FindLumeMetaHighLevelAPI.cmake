cmake_minimum_required(VERSION 3.19)
if (NOT TARGET LumeMeta::HighLevelAPI)
    find_package(LumeMetaAPI REQUIRED)
    get_filename_component(root_path "${CMAKE_CURRENT_LIST_DIR}/../" ABSOLUTE)
    add_library(LumeMeta::HighLevelAPI INTERFACE IMPORTED GLOBAL)
    set_property(TARGET LumeMeta::HighLevelAPI PROPERTY CXX_STANDARD 17)
    target_include_directories(LumeMeta::HighLevelAPI INTERFACE ${root_path}/include)
    target_link_libraries(LumeMeta::HighLevelAPI INTERFACE LumeMeta::API)
endif()
set(LumeMetaHighLevelAPI_FOUND true)