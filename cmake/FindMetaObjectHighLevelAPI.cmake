cmake_minimum_required(VERSION 3.19)
if (NOT TARGET MetaObject::HighLevelAPI)
    find_package(MetaObjectAPI REQUIRED)
    get_filename_component(root_path "${CMAKE_CURRENT_LIST_DIR}/../" ABSOLUTE)
    add_library(MetaObject::HighLevelAPI INTERFACE IMPORTED GLOBAL)
    set_property(TARGET MetaObject::HighLevelAPI PROPERTY CXX_STANDARD 17)
    target_include_directories(MetaObject::HighLevelAPI INTERFACE ${root_path}/include)
    target_link_libraries(MetaObject::HighLevelAPI INTERFACE MetaObject::API)
endif()
set(MetaObjectHighLevelAPI_FOUND true)