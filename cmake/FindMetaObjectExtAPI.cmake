cmake_minimum_required(VERSION 3.19)
if (NOT TARGET MetaObject::ExtAPI)
    find_package(MetaObjectAPI REQUIRED)
    get_filename_component(root_path "${CMAKE_CURRENT_LIST_DIR}/../" ABSOLUTE)
    add_library(MetaObject::ExtAPI INTERFACE IMPORTED GLOBAL)
    set_property(TARGET MetaObject::ExtAPI PROPERTY CXX_STANDARD 17)
    target_include_directories(MetaObject::ExtAPI INTERFACE ${root_path}/include)
    target_link_libraries(MetaObject::ExtAPI INTERFACE MetaObject::API)
endif()
set(MetaObjectExtAPI_FOUND true)