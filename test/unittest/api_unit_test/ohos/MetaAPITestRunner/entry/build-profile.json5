{
  "apiType": "stageMode",
  "buildOption": {
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "-DMETA_UNIT_TESTS_ENABLED=off",
      "cppFlags": "",
      "abiFilters": ["arm64-v8a"]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation" : {
          "ruleOptions":{
            "enable": true,
            "files": ["./obfuscation-rules.txt"]
          }
        }
      },"nativeLib": {
        "debugSymbol": {
          "strip": true,
          "exclude": []
        }
      }
    },
  ],
  "targets": [
    {
      "name": "default"
    }
    ,
    {
      "name": "ohosTest",
    }
  ]
}