cmake_minimum_required(VERSION 3.19)
if (NOT TARGET AGPEngine::AGPEngineDLL) 
    get_filename_component(root_path "${CMAKE_CURRENT_LIST_DIR}/../" ABSOLUTE)
    get_filename_component(bin_path "${root_path}/bin/" ABSOLUTE)
    add_library(AGPEngine::AGPEngineDLL SHARED IMPORTED GLOBAL)
    if (${CMAKE_SYSTEM_NAME} STREQUAL "Android")
        set_property(TARGET AGPEngine::AGPEngineDLL PROPERTY IMPORTED_LOCATION "${bin_path}/Release/${CMAKE_ANDROID_ARCH_ABI}/libAGPEngineDLL.so")
        set_property(TARGET AGPEngine::AGPEngineDLL PROPERTY IMPORTED_LOCATION_DEBUG "${bin_path}/Debug/${CMAKE_ANDROID_ARCH_ABI}/libAGPEngineDLL.so")
        set_property(TARGET AGPEngine::AGPEngineDLL PROPERTY IMPORTED_LOCATION_RELEASE "${bin_path}/Release/${CMAKE_ANDROID_ARCH_ABI}/libAGPEngineDLL.so")
    elseif (${CMAKE_SYSTEM_NAME} STREQUAL "Windows")
        set_property(TARGET AGPEngine::AGPEngineDLL PROPERTY IMPORTED_LOCATION "${bin_path}/Release/Win64/AGPEngineDLL.dll")
        set_property(TARGET AGPEngine::AGPEngineDLL PROPERTY IMPORTED_LOCATION_DEBUG "${bin_path}/Debug/Win64/AGPEngineDLL.dll")
        set_property(TARGET AGPEngine::AGPEngineDLL PROPERTY IMPORTED_LOCATION_RELEASE "${bin_path}/Release/Win64/AGPEngineDLL.dll")
    else()
        message(FATAL_ERROR "Unknown system ${CMAKE_SYSTEM_NAME}")
    endif()
endif()
set(AGPEngineDLL_FOUND true)