cmake_minimum_required(VERSION 3.19)
if (NOT TARGET securec::securec)
    find_package(SecurecAPI REQUIRED)
    get_filename_component(root_path "${CMAKE_CURRENT_LIST_DIR}/../" ABSOLUTE)
    add_library(securec::securec STATIC IMPORTED GLOBAL)
    set_property(TARGET securec::securec PROPERTY CXX_STANDARD 17)

    if (${CMAKE_SYSTEM_NAME} STREQUAL "Android")
        set_property(TARGET securec::securec PROPERTY IMPORTED_LOCATION "${root_path}/bin/Release/${CMAKE_ANDROID_ARCH_ABI}/libsecurec.a")
        set_property(TARGET securec::securec PROPERTY IMPORTED_LOCATION_DEBUG "${root_path}/bin/Debug/${CMAKE_ANDROID_ARCH_ABI}/libsecurec.a")
        set_property(TARGET securec::securec PROPERTY IMPORTED_LOCATION_RELEASE "${root_path}/bin/Release/${CMAKE_ANDROID_ARCH_ABI}/libsecurec.a")
    else()
        set_property(TARGET securec::securec PROPERTY IMPORTED_LOCATION "${root_path}/bin/Release/Win64/securec.lib")
        set_property(TARGET securec::securec PROPERTY IMPORTED_LOCATION_DEBUG "${root_path}/bin/Debug/Win64/securec.lib")
        set_property(TARGET securec::securec PROPERTY IMPORTED_LOCATION_RELEASE "${root_path}/bin/Release/Win64/securec.lib")
    endif()
    target_include_directories(securec::securec INTERFACE ${root_path}/securec/)
    target_link_libraries(securec::securec INTERFACE securec::SecurecAPI)
endif()
set(SecureC_FOUND true)