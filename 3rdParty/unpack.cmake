# Use the CORE definition for unpacked sources.
if(NOT CORE_UNPACKED_LIB_DIR)
    set(CORE_UNPACKED_LIB_DIR "${CMAKE_BINARY_DIR}/unpacked")
endif()

function(Unpack archive destinationDir archiveBasename resultOut)
    file(TIMESTAMP ${archive} archiveTimestamp "%s")
    set(result "${destinationDir}/${archiveBasename}_${archiveTimestamp}")
    if(NOT EXISTS "${result}")
        message(STATUS "Extracting '${archive}' to '${destinationDir}'")
        # Android studio sync runs configure in parallel for multiple build configurations.
        # Try to prevent conflicts by using a temporary dirname.
        string(RANDOM LENGTH 8 tempDirName)
        set(destinationTempDir "${destinationDir}/${archiveBasename}_tmp${tempDirName}")
        file(MAKE_DIRECTORY "${destinationTempDir}")
        execute_process(COMMAND ${CMAKE_COMMAND} -E tar xf ${archive} WORKING_DIRECTORY ${destinationTempDir} ERROR_VARIABLE errorMsg)
        if(errorMsg)
            message(WARNING "Error unpacking external library: ${archive}: ${errorMsg}")
        endif()
        if (NOT EXISTS "${destinationTempDir}/${archiveBasename}")
            message(FATAL_ERROR "Could not find the archive unpacked contents: ${destinationTempDir}/${archiveBasename}. Maybe git LFS is not working?")
        endif()
        if(NOT EXISTS "${result}")
            file(RENAME "${destinationTempDir}/${archiveBasename}" ${result})
        endif()
        file(REMOVE_RECURSE ${destinationTempDir})
    endif()
    set(${resultOut} ${result} PARENT_SCOPE)
endfunction()
